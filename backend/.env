# ==============================================================================
# Backend Environment Configuration (.env)
# ==============================================================================

# Application Settings
PROJECT_NAME="MarketSphere Multi-Vendor Platform"
VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"

# Security & Authentication (Generate random 32+ byte string in production)
SECRET_KEY="09d25e094faa6ca2556c818166b7a9563b93f7099f6f0f4caa6cf63b88e8d3e7"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# Database Configuration (SQLite default; can be switched to PostgreSQL)
DATABASE_URL="sqlite+aiosqlite:///./multivendor.db"
# Example PostgreSQL URL:
# DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/multivendor"

# Commerce Platform Defaults
DEFAULT_CURRENCY="USD"
DEFAULT_PLATFORM_COMMISSION_PERCENTAGE=10.0
DEFAULT_TAX_PERCENTAGE=5.0
DEFAULT_FLAT_SHIPPING_FEE=5.00

# CORS Allowed Origins (comma-separated JSON list)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8000","http://127.0.0.1:8000","http://localhost:8001","http://127.0.0.1:8001"]
