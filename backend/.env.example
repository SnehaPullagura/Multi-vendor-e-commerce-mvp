# Backend Environment Template (.env.example)
PROJECT_NAME="MarketSphere Multi-Vendor Platform"
VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"

SECRET_KEY="your-super-secret-jwt-key-here"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

DATABASE_URL="sqlite+aiosqlite:///./multivendor.db"
DEFAULT_CURRENCY="USD"
DEFAULT_PLATFORM_COMMISSION_PERCENTAGE=10.0
DEFAULT_TAX_PERCENTAGE=5.0
DEFAULT_FLAT_SHIPPING_FEE=5.00
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8001","http://127.0.0.1:8001"]
